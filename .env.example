# Copy to .env.local and fill in values. Never commit real values.

# Neon pooled connection string (hostname contains "-pooler"). Used by the app at runtime.
DATABASE_URL=

# Neon direct (unpooled) connection string. Used by the Prisma CLI (prisma.config.ts).
DATABASE_URL_UNPOOLED=

# OpenAI API key for trip-preference suggestions. Server only; never expose it.
OPENAI_API_KEY=

# Set to 1 to turn AI suggestions off (manual preferences keep working).
AI_DISABLED=
