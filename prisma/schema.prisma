// Connection URLs live in prisma.config.ts (CLI) and lib/db.ts (runtime).
// Tables arrive with their milestones; see project-plan.md §4.2.
// Naming: snake_case tables and columns in Postgres, camelCase in Prisma.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A published dataset we import from (project-plan.md §3.4–3.6, §6.2).
// Import runs, preserved metadata copies, and public areas link here in
// later milestones.
model DataSource {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stable key the importer upserts on, e.g. "md-imap-dnr-owned-lands".
  slug        String   @unique
  // Display name, e.g. "DNR Owned Lands and Conservation Easements".
  name        String
  // Canonical page for the source (catalog item or publisher page) shown to users.
  url         String
  // Credit shown wherever the data appears, e.g. "MD iMAP, Maryland DNR".
  attribution String
  // Published reuse terms, recorded verbatim as retrieved (§3.6).
  reuseTerms  String   @map("reuse_terms")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("data_sources")
}

// A saved trip plan for the Week 7 gate demo (project-plan.md §9, temporary
// priority). No accounts: anyone with the random id can view it. Only
// validated option values and dates are stored, never the raw description
// or any free text.
model Trip {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Validated preferences: { counties, species, methods, startDate, endDate }.
  preferences Json     @db.JsonB
  // Whether an AI suggestion was used before the user saved.
  aiAssisted  Boolean  @map("ai_assisted")
  // True only for records created by automated checks.
  isSynthetic Boolean  @default(false) @map("is_synthetic")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("trips")
}

// Durable, shared AI call allowance. A call is reserved atomically
// (used_calls + 1 where used_calls < max_calls) before contacting the
// provider, and is never released: failures and timeouts still count.
model AiAllowance {
  // "gate-demo" for the app; ids starting "synthetic-" are test records.
  id        String   @id
  maxCalls  Int      @map("max_calls")
  usedCalls Int      @default(0) @map("used_calls")
  // Off switch that works without a redeploy.
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("ai_allowances")
}
